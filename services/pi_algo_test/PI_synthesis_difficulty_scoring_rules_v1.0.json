{
  "config_name": "PI_Synthesis_Difficulty_Scoring_Rules",
  "config_version": "1.0.0",
  "language": "zh-CN",
  "scope": {
    "applicable_process": "聚酰亚胺低温溶液缩聚或低温一锅法工艺筛选",
    "temperature_range_c": [
      0,
      60
    ],
    "reaction_time_range_h": [
      4,
      48
    ],
    "solvent_volume_options_ml": [
      40,
      50,
      60
    ],
    "notes": [
      "本规则用于二胺-二酐体系的工程启发式评分和工艺包选择。",
      "本规则不适用于必须在高于60℃条件下完成的典型高温一步热亚胺化。",
      "溶剂体积的比较仅在单体总投料规模、反应器规格和溶剂种类基本固定时有效。"
    ]
  },
  "required_inputs": {
    "diamine": {
      "required": true,
      "fields": [
        "structure",
        "monomer_id",
        "functional_group_count",
        "electronic_features",
        "steric_features",
        "predicted_or_measured_solubility"
      ]
    },
    "dianhydride": {
      "required": true,
      "fields": [
        "structure",
        "monomer_id",
        "functional_group_count",
        "electronic_features",
        "steric_features",
        "predicted_or_measured_solubility"
      ]
    },
    "process_context": {
      "required": true,
      "fields": [
        "solvent",
        "monomer_scale",
        "reactor_volume",
        "water_content_status",
        "inert_atmosphere_status",
        "historical_similar_experiment"
      ]
    }
  },
  "score_formula": {
    "total_difficulty": "D = R + H + S + U",
    "chemical_difficulty": "C = R + H",
    "physical_execution_difficulty": "P = S + U",
    "ranges": {
      "R": [
        0,
        35
      ],
      "H": [
        0,
        25
      ],
      "S": [
        0,
        25
      ],
      "U": [
        0,
        15
      ],
      "D": [
        0,
        100
      ],
      "C": [
        0,
        60
      ],
      "P": [
        0,
        40
      ]
    }
  },
  "general_scoring_rules": [
    "必须逐项计算R、H、S、U，不允许直接凭整体印象给出D。",
    "每一个加分或减分项必须输出对应结构或实验依据。",
    "同一物理或化学效应不得在多个维度重复计分。",
    "电子效应只进入R。",
    "官能团局部空间阻碍只进入H。",
    "单体溶解、聚合物析出、增黏和混合困难只进入S。",
    "水解、氧化、热敏感和多官能凝胶风险只进入U。",
    "已有实验数据优先级高于结构推断。",
    "信息缺失时使用规定的默认中性分，并降低confidence。"
  ],
  "scoring_dimensions": {
    "R": {
      "name": "反应活性难度",
      "range": [
        0,
        35
      ],
      "formula": "R = R_DI + R_DA",
      "subscores": {
        "R_DI": {
          "name": "二胺活性难度",
          "range": [
            0,
            20
          ],
          "base_score_rule": "必须且只能选择一个基础类型分",
          "base_scores": [
            {
              "condition": "脂肪族伯二胺，两个氨基充分暴露",
              "score": 2
            },
            {
              "condition": "脂环族伯二胺",
              "score": 4
            },
            {
              "condition": "电子丰富的芳香二胺",
              "score": 5
            },
            {
              "condition": "普通对位芳香二胺",
              "score": 7
            },
            {
              "condition": "普通间位芳香二胺",
              "score": 9
            },
            {
              "condition": "强吸电子芳香二胺或缺电子杂芳二胺",
              "score": 12
            },
            {
              "condition": "氨基亲核性明显受抑制的特殊二胺",
              "score": 15
            }
          ],
          "corrections": [
            {
              "condition": "氨基所在芳环有一个明显给电子基团",
              "score_delta": -1
            },
            {
              "condition": "氨基所在芳环有两个及以上给电子基团",
              "score_delta": -2
            },
            {
              "condition": "氨基所在芳环直接连接醚桥",
              "score_delta": -1
            },
            {
              "condition": "氨基所在芳环连接一个弱吸电子基团",
              "score_delta": 1
            },
            {
              "condition": "氨基附近有一个CF3、羰基或砜基",
              "score_delta": 2
            },
            {
              "condition": "氨基附近有多个强吸电子基团",
              "score_delta": 3
            },
            {
              "condition": "氨基位于明显缺电子杂芳环",
              "score_delta": 3
            },
            {
              "condition": "两个氨基电子环境轻度不一致",
              "score_delta": 1
            },
            {
              "condition": "一个氨基明显比另一个活性低",
              "score_delta": 2
            },
            {
              "condition": "一个氨基几乎失去正常伯胺反应性",
              "score_delta": 4
            }
          ],
          "calculation": "R_DI = clip(base_score + sum(corrections), 0, 20)",
          "anti_double_counting": "邻位取代造成的空间位阻不得在R_DI计分，应进入H_DI。"
        },
        "R_DA": {
          "name": "二酐活性难度",
          "range": [
            0,
            15
          ],
          "base_score_rule": "必须且只能选择一个基础类型分",
          "base_scores": [
            {
              "condition": "小体积、电子缺陷明显、酸酐羰基亲电性高",
              "score": 2
            },
            {
              "condition": "常规芳香二酐",
              "score": 5
            },
            {
              "condition": "含柔性桥键的芳香二酐",
              "score": 5
            },
            {
              "condition": "电子密度较高的芳香二酐",
              "score": 7
            },
            {
              "condition": "半脂环族或亲电性偏低的二酐",
              "score": 8
            },
            {
              "condition": "酸酐羰基亲电性明显较低的特殊二酐",
              "score": 10
            }
          ],
          "corrections": [
            {
              "condition": "酸酐附近存在明显吸电子结构",
              "score_delta": -1
            },
            {
              "condition": "两个酸酐基团高度对称且电子环境一致",
              "score_delta": -1
            },
            {
              "condition": "酸酐附近存在一个给电子基团",
              "score_delta": 1
            },
            {
              "condition": "酸酐附近存在多个给电子基团",
              "score_delta": 2
            },
            {
              "condition": "两个酸酐基团电子环境明显不同",
              "score_delta": 2
            },
            {
              "condition": "一个酸酐基团明显比另一个反应性低",
              "score_delta": 3
            }
          ],
          "calculation": "R_DA = clip(base_score + sum(corrections), 0, 15)",
          "anti_double_counting": "酸酐湾区、邻位大体积取代和空间遮蔽不得在R_DA计分，应进入H_DA。"
        }
      }
    },
