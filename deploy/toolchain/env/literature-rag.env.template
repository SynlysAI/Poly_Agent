# ============================================================
# Poly_Agent Literature RAG 独立实例环境变量模板
# ============================================================
# 使用方法：
#   cp deploy/toolchain/env/literature-rag.env.template services/literature-rag/.env
#   然后编辑 services/literature-rag/.env 填入实际密钥和地址。
#
# 注意：
#   - 这是 Poly_Agent 专用实例模板，不要覆盖共享焊接/稀土/表面处理实例。
#   - 生产环境请使用独立 MongoDB / MinIO / Neo4j。
#   - 模板不包含任何真实密钥。
# ============================================================

APP_ENV=production
LITERATURE_RAG_BACKEND=production
LITERATURE_RAG_DEFAULT_CORPUS_ID=krf_photoresist

# 查询与管理密钥
LITERATURE_RAG_QUERY_API_KEY=replace-with-query-key
LITERATURE_RAG_ADMIN_API_KEY=replace-with-admin-key

# 独立存储
LITERATURE_RAG_MONGODB_URI=mongodb://127.0.0.1:27017
LITERATURE_RAG_MONGODB_DATABASE=poly_agent_literature_rag
LITERATURE_RAG_MINIO_ENDPOINT=127.0.0.1:9000
LITERATURE_RAG_MINIO_ACCESS_KEY=minioadmin
LITERATURE_RAG_MINIO_SECRET_KEY=replace-with-minio-secret
LITERATURE_RAG_MINIO_BUCKET=poly-agent-literature-rag
LITERATURE_RAG_MINIO_SECURE=false
LITERATURE_RAG_NEO4J_URI=bolt://127.0.0.1:7687
LITERATURE_RAG_NEO4J_USERNAME=neo4j
LITERATURE_RAG_NEO4J_PASSWORD=replace-with-neo4j-password

# Embedding / worker
LITERATURE_RAG_EMBEDDING_MODEL=BAAI/bge-m3
LITERATURE_RAG_EMBEDDING_DIMENSIONS=1024
LITERATURE_RAG_MEMORY_INLINE_WORKER=false

# PM2 启动参数
POLY_AGENT_CONDA_ENV=poly_agent
LITERATURE_RAG_PORT=8210
LITERATURE_RAG_PYTHON_BIN=
