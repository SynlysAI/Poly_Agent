# ============================================================
# Poly_Agent Backend 环境变量模板
# ============================================================
# 使用方法：
#   cp deploy/toolchain/env/backend.env.template backend/.env
#   然后编辑 backend/.env 填入实际密钥和配置。
#
# 注意：
#   - 此模板不包含任何密钥、API Key、凭据。
#   - 密钥类字段请通过环境变量或 .env 文件单独注入。
#   - 部署包不会将 .env 打包进 tgz。
# ============================================================

# ---- 应用基础配置 ----
APP_ENV=dev
POLY_AGENT_PROJECT_ROOT=
POLY_AGENT_RUNTIME_ROOT=.runtime
POLY_AGENT_UPLOAD_ROOT=.runtime/uploads
POLY_AGENT_OUTPUT_ROOT=.runtime/outputs

# MinIO / S3 data catalog
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=polymer-data
MINIO_SECURE=false
DATA_CATALOG_CACHE_TTL_SECONDS=900
POLY_AGENT_LOG_ROOT=.runtime/logs

# ---- 独立文献 RAG 服务配置 ----
# 未配置时不伪造真实知识源；前端知识库体系由远端 corpus registry 动态加载。
# LITERATURE_RAG_BASE_URL=http://127.0.0.1:8200
# LITERATURE_RAG_API_KEY=replace-with-query-key
# 若与独立服务共用同一份环境，也可只设置 LITERATURE_RAG_QUERY_API_KEY。
# KNOWLEDGE_DEFAULT_SYSTEM_ID=

# ---- 后端服务端口 ----
POLY_AGENT_BACKEND_PORT=5100

# ---- 认证配置 ----
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123456
# AUTH_SECRET=                            # 生产环境请填入随机密钥
AUTH_TOKEN_EXPIRE_HOURS=12
AUTH_BOOTSTRAP_ENABLED=true
AUTH_INVITE_DEFAULT_HOURS=72

# ---- MongoDB 配置 ----
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
# MONGODB_USERNAME=                       # 生产环境请填入
# MONGODB_PASSWORD=                       # 生产环境请填入
MONGODB_DATABASE=poly_agent
MONGODB_AUTH_SOURCE=admin
REQUIRE_MONGODB=true

# ---- 统一认证数据库（AI4MS） ----
# AUTH_MONGODB_URI=
# AUTH_MONGODB_DATABASE=ai4ms

# ---- 只读材料数据资产库（AI4MS Poly_Agent） ----
# DATA_ASSET_MONGODB_URI=
DATA_ASSET_MONGODB_DATABASE=ai4ms

# ---- ALchemist 主动学习后端地址 ----
ALCHEMIST_BACKEND_URL=http://127.0.0.1:8004/api/v1

# ---- LLM 配置（无默认值，须用户填入） ----
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ---- 自动研发报告生成 ----
REPORTS_ENABLED=true
REPORT_OUTPUT_ROOT=.runtime/reports
# openai_responses | openai_compatible | local_ollama | codex_exec | custom_http | mock(dev/test only)
REPORT_LLM_PROVIDER=openai_compatible
REPORT_LLM_FALLBACK_PROVIDERS=openai_compatible,local_ollama
REPORT_SKILL_PIPELINE_DEFAULT=nature_research_report_zh
REPORT_SKILL_ALLOWLIST=nature-writing,nature-polishing,nature-data,nature-reviewer,nature-academic-search,nature-citation,nature-figure,nature-reader
REPORT_SKILL_STRICT_MODE=true
# REPORT_LLM_API_KEY=                    # 未设置时回退 LLM_API_KEY 或 OPENAI_API_KEY
# REPORT_LLM_BASE_URL=                   # OpenAI-compatible 网关填写
# REPORT_LLM_MODEL=                      # 未设置时回退 LLM_MODEL
REPORT_LLM_TIMEOUT_SECONDS=180
REPORT_LLM_MAX_RETRIES=2
REPORT_LLM_STORE=false
REPORT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# REPORT_OLLAMA_MODEL=
REPORT_CODEX_BIN=codex
# REPORT_CODEX_API_KEY=                  # 推荐由 secret 注入；未设置时可回退 CODEX_API_KEY
# REPORT_CODEX_MODEL=
REPORT_CODEX_TIMEOUT_SECONDS=600
REPORT_CODEX_SANDBOX_WORKDIR=.runtime/reports
REPORT_LATEX_ENGINE=xelatex
REPORT_PDF_TIMEOUT_SECONDS=120
REPORT_KEEP_INTERMEDIATE=true

# ---- ORCA 量子化学配置 ----
# ORCA_EXECUTION_MODE=disabled            # disabled | local | compute_engine
# ORCA_LICENSE_AVAILABLE=false
ORCA_EXECUTABLE=orca

# ---- HPC 队列配置 ----
# HPC_QUEUE_AVAILABLE=false
# HPC_QUEUE_NAME=default

# ---- xTB / CREST 可执行文件路径 ----
XTB_EXECUTABLE=xtb
CREST_EXECUTABLE=crest

# ---- PM2 部署变量 ----
POLY_AGENT_CONDA_ENV=poly_agent
POLY_AGENT_PYTHON_BIN=
