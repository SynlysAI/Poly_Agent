APP_ENV=dev

# 开发默认允许 127.0.0.1/localhost 前端端口；生产环境必须显式配置真实 Origin。
# CORS_ALLOWED_ORIGINS=https://polyagent.example.com
CORS_ALLOW_CREDENTIALS=true

AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123456
# AUTH_SECRET=   # 生产环境必须设置，与 AI4MS 保持一致
AUTH_TOKEN_EXPIRE_HOURS=12
# AUTH_MONGODB_URI=mongodb://admin:password123@localhost:27018/ai4ms?authSource=admin
# AUTH_MONGODB_DATABASE=ai4ms
# DATA_ASSET_MONGODB_URI=mongodb://readonly:password@mongo-host:27017/poly_data?authSource=admin
DATA_ASSET_MONGODB_DATABASE=poly_data

# SFTP source for Poly Data migration script. Inject SFTP_PASSWORD only at runtime.
SFTP_HOST=10.26.15.53
SFTP_PORT=22
SFTP_USERNAME=fangyikai
SFTP_ROOT=/polymer-multi-modal/open-databases/Processed_data

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123
MONGODB_DATABASE=poly_agent
MONGODB_AUTH_SOURCE=admin
REQUIRE_MONGODB=true

# 真实计算工具链：生产路径不启用 mock/fake/fixture。
# 可填绝对路径，或确保这些命令在服务 PATH 中。
XTB_EXECUTABLE=xtb
CREST_EXECUTABLE=crest
ORCA_EXECUTABLE=orca
ORCA_EXECUTION_MODE=disabled
ORCA_LICENSE_AVAILABLE=false

POLY_AGENT_RUNTIME_ROOT=.runtime
POLY_AGENT_UPLOAD_ROOT=.runtime/uploads
POLY_AGENT_OUTPUT_ROOT=.runtime/outputs
POLY_AGENT_LOG_ROOT=.runtime/logs

# 用户上传垂类算法运行时。默认是本机短生命周期 Python 子进程沙箱：
# - 环境变量 allowlist，避免把密钥传入用户代码
# - 单次调用按算法契约 timeout_seconds 超时终止
# - stdout/stderr 截断保存，按 ALGORITHM_RUNTIME_MAX_CONCURRENCY 控制并发
# - requirements.txt 当前只做来源策略校验和 environment digest 记录，不自动 pip install
# 可选兼容值 local_inprocess 仅用于本地开发/旧测试，不建议生产使用。
ALGORITHM_RUNTIME_BACKEND=local_sandbox_runtime
ALGORITHM_RUNTIME_MAX_OUTPUT_BYTES=65536
ALGORITHM_RUNTIME_MAX_CONCURRENCY=2

# LLM 配置（OpenAI 兼容接口）
# LLM_API_KEY=sk-your-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_DEFAULT_PROVIDER=default_openai
# LLM_DEFAULT_MODEL=gpt-4o
# LLM_REASONING_PROVIDER=default_openai
# LLM_REASONING_MODEL=DeepSeek-V4-Flash-w8a8-mtp
# 多 provider 只保存 endpoint 和 key 的环境变量引用，不保存明文 key。
# LLM_PROVIDER_CONFIGS_JSON=[{"provider_id":"reasoning_primary","display_name":"Reasoning Primary","provider_type":"openai_compatible","base_url":"https://reasoning-gateway.example/v1","api_key_env":"LLM_REASONING_API_KEY","models":["Qwen3.6-35B-A3B"],"capabilities":["chat","reasoning","structured_json"],"recommended_for":["deep"]}]
# LLM_REASONING_API_KEY=sk-your-reasoning-key

# 独立文献 RAG 服务（旧 KNOWLEDGE_RAG_* 变量仍兼容）
# LITERATURE_RAG_BASE_URL=http://127.0.0.1:8200
# LITERATURE_RAG_API_KEY=replace-with-query-key
# 若与独立服务共用同一份环境，也可只设置 LITERATURE_RAG_QUERY_API_KEY。
# 可选：前端首选选中的远端 corpus ID；不会创建本地 fallback 数据源。
# KNOWLEDGE_DEFAULT_SYSTEM_ID=

# 自动研发报告生成
REPORTS_ENABLED=true
REPORT_OUTPUT_ROOT=.runtime/reports
REPORT_LLM_PROVIDER=openai_compatible
REPORT_SKILL_PIPELINE_DEFAULT=nature_research_report_zh
# REPORT_LLM_API_KEY=                    # 未设置时回退 LLM_API_KEY 或 OPENAI_API_KEY
# REPORT_LLM_MODEL=                      # 未设置时回退 LLM_MODEL
REPORT_LATEX_ENGINE=xelatex

# SpecLabOS 外部实验任务下发
SPECLABOS_BASE_URL=http://127.0.0.1:8010
SPECLABOS_API_KEY=dev-speclabos-token
SPECLABOS_TIMEOUT_SECONDS=30
