APP_ENV=dev

AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123456
# AUTH_SECRET=   # 生产环境必须设置，与 AI4MS 保持一致
AUTH_TOKEN_EXPIRE_HOURS=12
# AUTH_MONGODB_URI=mongodb://admin:password123@localhost:27018/ai4ms?authSource=admin
# AUTH_MONGODB_DATABASE=ai4ms

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123
MONGODB_DATABASE=poly_agent

POLY_AGENT_RUNTIME_ROOT=.runtime
POLY_AGENT_UPLOAD_ROOT=.runtime/uploads
POLY_AGENT_OUTPUT_ROOT=.runtime/outputs
POLY_AGENT_LOG_ROOT=.runtime/logs

# LLM 配置（OpenAI 兼容接口）
# LLM_API_KEY=sk-your-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
